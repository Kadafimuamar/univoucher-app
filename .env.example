# Which Unicity network to transact on: 'testnet' while building, 'mainnet' for real value.
VITE_UNICITY_NETWORK=testnet

# The Unicity ID (nametag) that receives payment for vouchers.
# This is UniVoucher's own merchant wallet — replace with yours.
VITE_MERCHANT_NAMETAG=univoucher

# Display name and description shown in the wallet's connection approval prompt.
VITE_DAPP_NAME=UniVoucher
VITE_DAPP_DESCRIPTION=Buy digital game vouchers, paid peer-to-peer in UCT.

# If you host Sphere itself as a popup instead of relying on the browser
# extension, point this at the deployed wallet origin.
VITE_SPHERE_WALLET_URL=https://sphere.unicity.network
